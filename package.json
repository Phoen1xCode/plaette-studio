{
  "name": "plaette-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Perceptual ten-shade palette generator with TDesign React previews",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run lint && bun run fmt:check && bun run test && bun run build",
    "report": "bun scripts/palette-report.mjs",
    "test:browser": "bun scripts/run-browser-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "culori": "^4.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tdesign-react": "^1.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
